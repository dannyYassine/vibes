{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4-flash",
  "small_model": "openrouter/deepseek/deepseek-v4-flash",
  "default_agent": "main-flash",
  "mcp": {
    "code-review-graph": {
      "type": "local",
      "command": ["uvx", "code-review-graph", "serve"],
      "environment": {}
    }
  },
  "instructions": ["AGENTS.md"],
  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "options": {
            "provider": {
              "order": [
                "parasail/fp8",
                "novita/fp8",
                "siliconflow/fp8",
                "deepinfra",
                "digitalocean"
              ],
              "allow_fallbacks": true
            },
            "reasoning": { "enabled": true }
          },
          "interleaved": {
            "field": "reasoning_content"
          }
        },
        "z-ai/glm-5.2": {
          "name": "glm-5.2",
          "options": {
            "provider": {
              "order": ["z-ai/glm-5.2"],
              "allow_fallbacks": true
            },
            "reasoning": { "enabled": true, "reasoning_effort": "xhigh" }
          },
          "interleaved": {
            "field": "reasoning_content"
          }
        },
        "google/gemini-3.5-flash": {
          "name": "gemini-3.5-flash",
          "options": {
            "provider": {
              "order": ["google-ai-studio", "google-vertex/global"],
              "allow_fallbacks": true
            }
          }
        },
        "google/gemini-3.6-flash": {
          "name": "gemini-3.6-flash",
          "options": {
            "provider": {
              "order": ["google-ai-studio", "google-vertex/global"],
              "allow_fallbacks": true
            },
            "reasoning": { "enabled": true, "reasoning_effort": "high" }
          },
          "interleaved": {
            "field": "reasoning_content"
          }
        },
        "deepseek/deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "options": {
            "provider": {
              "order": ["deepinfra", "digitalocean", "siliconflow/fp8"],
              "allow_fallbacks": true
            },
            "reasoning": { "enabled": true }
          },
          "interleaved": {
            "field": "reasoning_content"
          }
        },
        "openai/gpt-5.4-mini": {
          "name": "gpt-5.4-mini",
          "options": {
            "provider": {
              "order": ["azure", "openai"],
              "allow_fallbacks": true
            }
          }
        },
        "moonshotai/kimi-k3": {
          "name": "kimi-k3",
          "options": {
            "provider": {
              "order": ["moonshotai"],
              "allow_fallbacks": true
            },
            "reasoning": { "enabled": true, "reasoning_effort": "high" }
          },
          "interleaved": {
            "field": "reasoning_content"
          }
        },
        "google/gemini-3-flash-preview": {
          "name": "gemini-3-flash-preview",
          "options": {
            "provider": {
              "order": ["google-ai-studio", "google-vertex/global"],
              "allow_fallbacks": true
            }
          }
        },
        "google/gemini-3.1-flash-lite": {
          "name": "gemini-3.1-flash-lite",
          "options": {
            "provider": {
              "order": ["google-vertex/global", "google-ai-studio"],
              "allow_fallbacks": true
            }
          }
        },
        "qwen/qwen3.7-max": {
          "name": "qwen3.7-max",
          "options": {
            "provider": {
              "order": ["alibaba"],
              "allow_fallbacks": true
            }
          }
        },
        "xiaomi/mimo-v2.5": {
          "name": "mimo-v2.5",
          "options": {
            "provider": {
              "order": ["xiaomi/fp8"],
              "allow_fallbacks": true
            }
          }
        },
        "minimax/minimax-m3": {
          "name": "minimax-m3",
          "options": {
            "provider": {
              "order": ["novita/fp8", "morph", "together", "deepinfra/bf16"],
              "allow_fallbacks": true
            }
          }
        }
      }
    }
  },
  "agent": {
    "plan-flash": {
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "description": "Fastest planning agent (deepseek-v4-flash)",
      "permission": { "edit": "deny", "bash": "deny", "read": "allow" },
      "prompt": "You are a planning agent. Produce detailed plans with file paths, architecture decisions, and dependency analysis. Do NOT write code or make edits."
    },
    "plan": {
      "model": "openrouter/deepseek/deepseek-v4-pro",
      "description": "Fast planning agent (deepseek-v4-pro)",
      "permission": { "edit": "deny", "bash": "deny", "read": "allow" },
      "prompt": "You are a planning agent. Produce detailed plans with file paths, architecture decisions, and dependency analysis. Do NOT write code or make edits."
    },
    "plan-high": {
      "mode": "primary",
      "model": "openrouter/z-ai/glm-5.2",
      "description": "High-quality planning agent (glm-5.2)",
      "permission": { "edit": "deny", "bash": "deny", "read": "allow" },
      "prompt": "You are a planning agent. Produce detailed plans with file paths, architecture decisions, and dependency analysis. Do NOT write code or make edits."
    },
    "plan-ultra": {
      "mode": "primary",
      "model": "openrouter/moonshotai/kimi-k3",
      "description": "Ultra deep planning agent (kimi-k3)",
      "permission": { "edit": "deny", "bash": "deny", "read": "allow" },
      "prompt": "You are a planning agent. Produce detailed plans with file paths, architecture decisions, and dependency analysis. Do NOT write code or make edits."
    },
    "main-flash": {
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "description": "Fastest main agent (deepseek-v4-flash)"
    },
    "main": {
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4-pro",
      "description": "Fast main agent (deepseek-v4-pro)"
    },
    "main-high": {
      "mode": "primary",
      "model": "openrouter/z-ai/glm-5.2",
      "description": "High-quality main agent (glm-5.2)"
    },
    "main-ultra": {
      "mode": "primary",
      "model": "openrouter/moonshotai/kimi-k3",
      "description": "Ultra deep main agent (kimi-k3)"
    },
    "ask-flash": {
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "description": "Fastest question-only agent (deepseek-v4-flash)",
      "permission": { "edit": "deny", "bash": "deny", "read": "allow" },
      "prompt": "You are a question-answering agent. Answer questions about the codebase using search and read tools. Do NOT write code, make edits, or run commands. Explain, do not execute."
    },
    "ask": {
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4-pro",
      "description": "Fast question-only agent (deepseek-v4-pro)",
      "permission": { "edit": "deny", "bash": "deny", "read": "allow" },
      "prompt": "You are a question-answering agent. Answer questions about the codebase using search and read tools. Do NOT write code, make edits, or run commands. Explain, do not execute."
    },
    "ask-high": {
      "mode": "primary",
      "model": "openrouter/z-ai/glm-5.2",
      "description": "High-quality question-only agent (glm-5.2)",
      "permission": { "edit": "deny", "bash": "deny", "read": "allow" },
      "prompt": "You are a question-answering agent. Answer questions about the codebase using search and read tools. Do NOT write code, make edits, or run commands. Explain, do not execute."
    },
    "ask-ultra": {
      "mode": "primary",
      "model": "openrouter/moonshotai/kimi-k3",
      "description": "Ultra deep question-only agent (kimi-k3)",
      "permission": { "edit": "deny", "bash": "deny", "read": "allow" },
      "prompt": "You are a question-answering agent. Answer questions about the codebase using search and read tools. Do NOT write code, make edits, or run commands. Explain, do not execute."
    }
  }
}
