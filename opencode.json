{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4.1-flash-1017",
  "small_model": "openrouter/deepseek/deepseek-v4.1-flash-1017",
  "default_agent": "main",
  "mcp": {
    "code-review-graph": {
      "type": "local",
      "command": ["uvx", "code-review-graph", "serve"],
      "environment": {}
    }
  },
  "instructions": ["AGENTS.md"],
  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4.1-flash-1017": {
          "name": "deepseek-v4.1-flash-1017",
          "options": {
            "provider": {
              "order": ["deepinfra", "digitalocean"],
              "allow_fallbacks": true
            },
            "reasoning": { "enabled": true }
          },
          "interleaved": {
            "field": "reasoning_content"
          }
        },
        "z-ai/glm-5.3": {
          "name": "glm-5.3",
          "options": {
            "provider": {
              "order": ["cloudflare", "baseten", "coreweave"],
              "allow_fallbacks": true
            },
            "reasoning": { "enabled": true, "reasoning_effort": "xhigh" }
          },
          "interleaved": {
            "field": "reasoning_content"
          }
        },
        "moonshotai/kimi-k3.1-pro": {
          "name": "kimi-k3.1-pro",
          "options": {
            "provider": {
              "order": ["moonshotai"],
              "allow_fallbacks": true
            },
            "reasoning": { "enabled": true, "reasoning_effort": "high" }
          },
          "interleaved": {
            "field": "reasoning_content"
          }
        }
      }
    }
  },
  "agent": {
    "plan": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017",
      "description": "Planning agent (deepseek-v4.1-flash-1017)",
      "permission": { "edit": "deny", "bash": "deny", "read": "allow" },
      "prompt": "You are a planning agent. Produce detailed plans with file paths, architecture decisions, and dependency analysis. Do NOT write code or make edits."
    },
    "plan-high": {
      "mode": "primary",
      "model": "openrouter/z-ai/glm-5.3",
      "description": "High-quality planning agent (glm-5.3)",
      "permission": { "edit": "deny", "bash": "deny", "read": "allow" },
      "prompt": "You are a planning agent. Produce detailed plans with file paths, architecture decisions, and dependency analysis. Do NOT write code or make edits."
    },
    "plan-ultra": {
      "mode": "primary",
      "model": "openrouter/moonshotai/kimi-k3.1-pro",
      "description": "Ultra deep planning agent (kimi-k3.1-pro)",
      "permission": { "edit": "deny", "bash": "deny", "read": "allow" },
      "prompt": "You are a planning agent. Produce detailed plans with file paths, architecture decisions, and dependency analysis. Do NOT write code or make edits."
    },
    "main": {
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017",
      "permission": { "edit": "allow", "bash": "allow", "read": "allow" },
      "description": "Main agent (deepseek-v4.1-flash-1017)"
    },
    "main-high": {
      "mode": "primary",
      "model": "openrouter/z-ai/glm-5.3",
      "permission": { "edit": "allow", "bash": "allow", "read": "allow" },
      "description": "High-quality main agent (glm-5.3)"
    },
    "main-ultra": {
      "mode": "primary",
      "model": "openrouter/moonshotai/kimi-k3.1-pro",
      "permission": { "edit": "allow", "bash": "allow", "read": "allow" },
      "description": "Ultra deep main agent (kimi-k3.1-pro)"
    },
    "ask": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017",
      "description": "Question-only agent (deepseek-v4.1-flash-1017)",
      "permission": { "edit": "deny", "bash": "deny", "read": "allow" },
      "prompt": "You are a question-answering agent. Answer questions about the codebase using search and read tools. Do NOT write code, make edits, or run commands. Explain, do not execute."
    },
    "ask-high": {
      "mode": "primary",
      "model": "openrouter/z-ai/glm-5.3",
      "description": "High-quality question-only agent (glm-5.3)",
      "permission": { "edit": "deny", "bash": "deny", "read": "allow" },
      "prompt": "You are a question-answering agent. Answer questions about the codebase using search and read tools. Do NOT write code, make edits, or run commands. Explain, do not execute."
    },
    "ask-ultra": {
      "mode": "primary",
      "model": "openrouter/moonshotai/kimi-k3.1-pro",
      "description": "Ultra deep question-only agent (kimi-k3.1-pro)",
      "permission": { "edit": "deny", "bash": "deny", "read": "allow" },
      "prompt": "You are a question-answering agent. Answer questions about the codebase using search and read tools. Do NOT write code, make edits, or run commands. Explain, do not execute."
    }
  }
}
